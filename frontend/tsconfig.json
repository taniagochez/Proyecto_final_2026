    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "isolatedModules": true, "skipLibCheck": true,
    "lib": ["ES2020", "DOM"], "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
