# Copia este archivo como backend/.env y completa los valores. NUNCA subas .env a GitHub (ya está en .gitignore).

# Conexión a MongoDB
#  - Local:  mongodb://127.0.0.1:27017
#  - Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/   (si la contraseña tiene símbolos como @ o #, codifícalos: @ = %40, # = %23)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=yli_gochez

# Firma de las sesiones (JWT). Pon una cadena larga y aleatoria, distinta en cada entorno.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

PORT=3000

# Asistente de IA (opcional)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=